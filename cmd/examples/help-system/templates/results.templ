package templates

templ Results(result *QueryResult) {
	<div class="mt-4">
		if result != nil && result.Query != nil {
			@QueryView(result.Query)

			if result.HelpPage != nil {
				@SectionList("Default General Topics", result.HelpPage.DefaultGeneralTopics)
				@SectionList("Other General Topics", result.HelpPage.OtherGeneralTopics)
				@SectionList("Default Examples", result.HelpPage.DefaultExamples)
				@SectionList("Other Examples", result.HelpPage.OtherExamples)
				@SectionList("Default Applications", result.HelpPage.DefaultApplications)
				@SectionList("Other Applications", result.HelpPage.OtherApplications)
				@SectionList("Default Tutorials", result.HelpPage.DefaultTutorials)
				@SectionList("Other Tutorials", result.HelpPage.OtherTutorials)

				if len(result.HelpPage.AllGeneralTopics) == 0 &&
					len(result.HelpPage.AllExamples) == 0 &&
					len(result.HelpPage.AllApplications) == 0 &&
					len(result.HelpPage.AllTutorials) == 0 {
					<div class="alert alert-info">
						No results found for the current query.
					</div>
				}
			}
		}
	</div>
} 