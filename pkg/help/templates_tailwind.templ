package help

import (
	"fmt"
	"strings"
)

// Layout provides the base HTML structure
templ Layout(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{title} - Help System</title>
		<link href="/static/style.css" rel="stylesheet"/>
		<script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
	</head>
	<body class="h-full">
		<nav class="elegant-navbar">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-16">
					<div class="flex items-center">
						<a href="/" class="flex items-center space-x-3 text-white font-bold text-xl">
							<svg class="w-8 h-8 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
								<path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
							</svg>
							<span>Help System</span>
						</a>
					</div>
					
					<div class="hidden md:block">
						<div class="flex items-center space-x-8">
							<a href="/" class="text-white hover:text-yellow-400 transition-colors duration-200 flex items-center space-x-1">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
								</svg>
								<span>Home</span>
							</a>
							<a href="/search" class="text-white hover:text-yellow-400 transition-colors duration-200 flex items-center space-x-1">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
								</svg>
								<span>Search</span>
							</a>
						</div>
					</div>
					
					<div class="flex items-center">
						<form action="/search" method="GET" class="relative">
							<div class="flex items-center bg-white/20 backdrop-blur-sm rounded-full overflow-hidden">
								<div class="pl-4 pr-2">
									<svg class="w-5 h-5 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
									</svg>
								</div>
								<input 
									type="search" 
									name="q" 
									placeholder="Search help..." 
									class="bg-transparent text-white placeholder-white/70 border-0 py-2 px-2 focus:outline-none focus:ring-0 w-48"
								/>
								<button 
									type="submit" 
									class="bg-white/20 hover:bg-white/30 transition-colors p-2 text-white"
								>
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
									</svg>
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</nav>
		
		<main class="min-h-screen">
			@content
		</main>
		
		<footer class="elegant-footer">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex flex-col md:flex-row justify-between items-center">
					<div class="mb-4 md:mb-0">
						<h6 class="text-lg font-semibold flex items-center space-x-2">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
							</svg>
							<span>Help System</span>
						</h6>
						<p class="text-white/70">Browse documentation, examples, and tutorials with ease.</p>
					</div>
					<div class="text-center md:text-right">
						<small class="text-white/60 flex items-center space-x-1">
							<svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
								<path d="M7 2v11h3v9l7-12h-4l4-8z"/>
							</svg>
							<span>Powered by Glazed Help System</span>
						</small>
					</div>
				</div>
			</div>
		</footer>
		<script src="/static/app.js"></script>
	</body>
	</html>
}

// IndexPage displays the main help page
templ IndexPage(data map[string]interface{}) {
	@Layout(data["Title"].(string), IndexContent(data))
}

templ IndexContent(data map[string]interface{}) {
	<div class="w-full">
		<!-- Hero Section -->
		<div class="hero-section mx-8 rounded-3xl shadow-2xl mb-12">
			<div class="max-w-6xl mx-auto px-8">
				<h1 class="text-5xl font-bold text-white mb-4">Help System</h1>
				<p class="text-xl text-white/80 mb-8">Browse documentation, examples, and tutorials for this application</p>
				
				<!-- Filter Buttons Row -->
				<div class="flex flex-wrap justify-center gap-3" x-data="{ activeFilter: 'all' }">
					<button 
						@click="activeFilter = 'all'; filterSections('all')" 
						:class="activeFilter === 'all' ? 'filter-btn-active' : ''"
						class="filter-btn bg-white text-blue-600 border-white hover:bg-blue-50"
						data-filter="all"
					>
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
						</svg>
						All Sections
					</button>
					<button 
						@click="activeFilter = 'GeneralTopic'; filterSections('GeneralTopic')" 
						:class="activeFilter === 'GeneralTopic' ? 'filter-btn-active' : ''"
						class="filter-btn bg-transparent text-white border-white hover:bg-white/10"
						data-filter="GeneralTopic"
					>
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
						</svg>
						Topics
					</button>
					<button 
						@click="activeFilter = 'Example'; filterSections('Example')" 
						:class="activeFilter === 'Example' ? 'filter-btn-active' : ''"
						class="filter-btn bg-transparent text-white border-white hover:bg-white/10"
						data-filter="Example"
					>
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
						</svg>
						Examples
					</button>
					<button 
						@click="activeFilter = 'Application'; filterSections('Application')" 
						:class="activeFilter === 'Application' ? 'filter-btn-active' : ''"
						class="filter-btn bg-transparent text-white border-white hover:bg-white/10"
						data-filter="Application"
					>
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
						</svg>
						Applications
					</button>
					<button 
						@click="activeFilter = 'Tutorial'; filterSections('Tutorial')" 
						:class="activeFilter === 'Tutorial' ? 'filter-btn-active' : ''"
						class="filter-btn bg-transparent text-white border-white hover:bg-white/10"
						data-filter="Tutorial"
					>
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
						</svg>
						Tutorials
					</button>
				</div>
			</div>
		</div>

		<!-- Content Sections -->
		<div class="max-w-7xl mx-auto px-8">
			if helpPage, ok := data["HelpPage"].(*HelpPage); ok {
				@TailwindSectionGroup("Featured Topics", helpPage.DefaultGeneralTopics, "primary")
				@TailwindSectionGroup("Quick Examples", helpPage.DefaultExamples, "success")
				@TailwindSectionGroup("Applications", helpPage.DefaultApplications, "warning")
				@TailwindSectionGroup("Step-by-Step Tutorials", helpPage.DefaultTutorials, "danger")
				
				if len(helpPage.OtherGeneralTopics) > 0 {
					@TailwindSectionGroup("More Topics", helpPage.OtherGeneralTopics, "secondary")
				}
				if len(helpPage.OtherExamples) > 0 {
					@TailwindSectionGroup("Additional Examples", helpPage.OtherExamples, "info")
				}
				if len(helpPage.OtherApplications) > 0 {
					@TailwindSectionGroup("More Applications", helpPage.OtherApplications, "dark")
				}
				if len(helpPage.OtherTutorials) > 0 {
					@TailwindSectionGroup("Advanced Tutorials", helpPage.OtherTutorials, "secondary")
				}
			}
		</div>
	</div>
}

// TailwindSectionGroup displays a group of sections with Tailwind styling
templ TailwindSectionGroup(title string, sections []*Section, colorTheme string) {
	if len(sections) > 0 {
		<div class="section-group animate-fade-in">
			<div class="flex items-center justify-between mb-6">
				<div class="flex-1">
					<h2 class={"text-3xl font-bold mb-2 " + getTextColor(colorTheme)}>{title}</h2>
					<div class="w-full bg-gray-200 rounded-full h-1">
						<div class={"h-1 rounded-full " + getBgColor(colorTheme)} style="width: 100%;"></div>
					</div>
				</div>
				<div class={"ml-6 px-4 py-2 rounded-full text-white font-semibold " + getBgColor(colorTheme)}>
					{fmt.Sprintf("%d", len(sections))}
				</div>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
				for _, section := range sections {
					@TailwindSectionCard(section, colorTheme)
				}
			</div>
		</div>
	}
}

// TailwindSectionCard displays a single section with Tailwind styling
templ TailwindSectionCard(section *Section, colorTheme string) {
	<div class="elegant-card animate-slide-up" data-section-type={section.SectionType.String()}>
		<div class={"section-card-header section-card-" + colorTheme}>
			<div class="flex justify-between items-center">
				@TailwindSectionIcon(section.SectionType, "w-8 h-8")
				@TailwindSectionTypeBadge(section.SectionType)
			</div>
		</div>
		<div class="p-6 flex flex-col h-full">
			<h5 class="text-xl font-bold mb-3">
				<a href={templ.URL("/section/" + section.Slug)} class={"text-decoration-none hover:underline " + getTextColor(colorTheme)}>
					{section.Title}
				</a>
			</h5>
			if section.Short != "" {
				<p class="text-gray-600 flex-grow mb-4">{section.Short}</p>
			}
			if len(section.Topics) > 0 || len(section.Commands) > 0 {
				<div class="flex flex-wrap gap-2 mt-auto">
					for _, topic := range section.Topics {
						<span class="px-2 py-1 bg-gray-100 text-gray-700 text-sm rounded-full">{topic}</span>
					}
					for _, command := range section.Commands {
						<span class={"px-3 py-1 text-white text-sm rounded-full flex items-center space-x-1 " + getBgColor(colorTheme)}>
							<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
							</svg>
							<span>{command}</span>
						</span>
					}
				</div>
			}
		</div>
		<div class="px-6 pb-6">
			<small class="text-gray-500 flex items-center space-x-1">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
				</svg>
				<span>Click to explore</span>
			</small>
		</div>
	</div>
}

// TailwindSectionIcon displays an icon for the section type
templ TailwindSectionIcon(sectionType SectionType, class string) {
	switch sectionType {
	case SectionGeneralTopic:
		<svg class={class + " text-white"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
		</svg>
	case SectionExample:
		<svg class={class + " text-white"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
		</svg>
	case SectionApplication:
		<svg class={class + " text-white"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
		</svg>
	case SectionTutorial:
		<svg class={class + " text-white"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z M12 14l-6.16-3.422a12.083 12.083 0 00-.665 6.479A11.952 11.952 0 0012 20.055"/>
		</svg>
	default:
		<svg class={class + " text-white"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
		</svg>
	}
}

// TailwindSectionTypeBadge displays a badge for the section type
templ TailwindSectionTypeBadge(sectionType SectionType) {
	switch sectionType {
	case SectionGeneralTopic:
		<span class="bg-white text-blue-600 px-3 py-1 rounded-full text-sm font-semibold">Topic</span>
	case SectionExample:
		<span class="bg-white text-green-600 px-3 py-1 rounded-full text-sm font-semibold">Example</span>
	case SectionApplication:
		<span class="bg-white text-yellow-600 px-3 py-1 rounded-full text-sm font-semibold">App</span>
	case SectionTutorial:
		<span class="bg-white text-red-600 px-3 py-1 rounded-full text-sm font-semibold">Tutorial</span>
	default:
		<span class="bg-white text-gray-600 px-3 py-1 rounded-full text-sm font-semibold">Unknown</span>
	}
}

// SectionPage displays a single section
templ SectionPage(data map[string]interface{}) {
	@Layout(data["Title"].(string), TailwindSectionContent(data))
}

templ TailwindSectionContent(data map[string]interface{}) {
	<div class="w-full">
		if section, ok := data["Section"].(*Section); ok {
			<!-- Header Section -->
			<div class="elegant-gradient mx-8 rounded-3xl shadow-2xl py-12 mb-12">
				<div class="max-w-6xl mx-auto px-8">
					<!-- Breadcrumb -->
					<nav class="mb-6">
						<ol class="flex items-center space-x-2 bg-white/20 backdrop-blur-sm rounded-full px-4 py-2 text-white">
							<li>
								<a href="/" class="hover:text-yellow-400 transition-colors flex items-center space-x-1">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
									</svg>
									<span>Home</span>
								</a>
							</li>
							<li>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
								</svg>
							</li>
							<li class="text-white/80">{section.Title}</li>
						</ol>
					</nav>
					
					<!-- Section Title Row -->
					<div class="flex flex-col lg:flex-row lg:items-center justify-between">
						<div class="flex items-center space-x-4 mb-6 lg:mb-0">
							@TailwindSectionIcon(section.SectionType, "w-12 h-12")
							<div>
								<h1 class="text-4xl lg:text-5xl font-bold text-white mb-2">{section.Title}</h1>
								if section.SubTitle != "" {
									<p class="text-xl text-white/80">{section.SubTitle}</p>
								}
							</div>
						</div>
						<div class="text-center lg:text-right">
							@TailwindSectionTypeBadge(section.SectionType)
							<div class="mt-4">
								<a href="/" class="elegant-btn-primary">
									<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
									</svg>
									Back to Home
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Meta Information Row -->
			if len(section.Topics) > 0 || len(section.Commands) > 0 || len(section.Flags) > 0 {
				<div class="max-w-6xl mx-auto px-8 mb-12">
					<div class="glass-morphism rounded-3xl shadow-xl p-8">
						<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
							if len(section.Topics) > 0 {
								<div>
									<h6 class="text-lg font-bold text-blue-600 mb-4 flex items-center space-x-2">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
										</svg>
										<span>Topics</span>
									</h6>
									<div class="flex flex-wrap gap-2">
										for _, topic := range section.Topics {
											<span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">{topic}</span>
										}
									</div>
								</div>
							}
							if len(section.Commands) > 0 {
								<div>
									<h6 class="text-lg font-bold text-green-600 mb-4 flex items-center space-x-2">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
										</svg>
										<span>Commands</span>
									</h6>
									<div class="flex flex-wrap gap-2">
										for _, command := range section.Commands {
											<code class="bg-gray-100 text-gray-800 px-3 py-1 rounded-lg text-sm font-mono">{command}</code>
										}
									</div>
								</div>
							}
							if len(section.Flags) > 0 {
								<div>
									<h6 class="text-lg font-bold text-yellow-600 mb-4 flex items-center space-x-2">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 2h7a2 2 0 012 2v6a2 2 0 01-2 2H6l-3 4z"/>
										</svg>
										<span>Flags</span>
									</h6>
									<div class="flex flex-wrap gap-2">
										for _, flag := range section.Flags {
											<code class="bg-gray-100 text-gray-800 px-3 py-1 rounded-lg text-sm font-mono">--{flag}</code>
										}
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			}
			
			<!-- Content Section -->
			<div class="max-w-4xl mx-auto px-8">
				<div class="bg-white rounded-3xl shadow-xl p-12 mb-12">
					<div class="help-content">
						@templ.Raw(renderMarkdown(section.Content))
					</div>
				</div>
			</div>
		}
	</div>
}

// SearchPage displays search results
templ SearchPage(data map[string]interface{}) {
	@Layout(data["Title"].(string), TailwindSearchContent(data))
}

templ TailwindSearchContent(data map[string]interface{}) {
	<div class="w-full">
		<!-- Search Header -->
		<div class="elegant-gradient mx-8 rounded-3xl shadow-2xl py-16 mb-12">
			<div class="max-w-6xl mx-auto px-8 text-center">
				<h1 class="text-5xl font-bold text-white mb-4 flex items-center justify-center space-x-4">
					<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
					</svg>
					<span>Search Help</span>
				</h1>
				<p class="text-xl text-white/80 mb-8">Find exactly what you're looking for</p>
				
				<!-- Search Form -->
				<div class="max-w-2xl mx-auto">
					<form action="/search" method="GET" class="bg-white/20 backdrop-blur-sm rounded-2xl p-6">
						<div class="grid grid-cols-1 md:grid-cols-12 gap-4">
							<div class="md:col-span-7">
								<div class="relative">
									<div class="absolute inset-y-0 left-0 pl-3 flex items-center">
										<svg class="w-5 h-5 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
										</svg>
									</div>
									<input 
										type="text" 
										name="q" 
										placeholder="Search for topics, examples, or tutorials..." 
										value={data["Query"].(string)}
										class="w-full pl-10 pr-4 py-3 bg-white/20 border border-white/30 rounded-xl text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white/50 focus:border-transparent"
									/>
								</div>
							</div>
							<div class="md:col-span-3">
								<select name="type" class="w-full py-3 px-4 bg-white/20 border border-white/30 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-white/50 focus:border-transparent">
									<option value="" class="text-gray-900">All Types</option>
									<option value="topics" if data["Type"].(string) == "topics" { selected } class="text-gray-900">Topics</option>
									<option value="examples" if data["Type"].(string) == "examples" { selected } class="text-gray-900">Examples</option>
									<option value="applications" if data["Type"].(string) == "applications" { selected } class="text-gray-900">Applications</option>
									<option value="tutorials" if data["Type"].(string) == "tutorials" { selected } class="text-gray-900">Tutorials</option>
								</select>
							</div>
							<div class="md:col-span-2">
								<button type="submit" class="w-full elegant-btn-primary">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
									</svg>
								</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>

		<!-- Search Results -->
		<div class="max-w-7xl mx-auto px-8">
			if results, ok := data["Results"].([]*Section); ok {
				if data["Query"].(string) != "" {
					<!-- Results Header -->
					<div class="flex flex-col md:flex-row justify-between items-center mb-8">
						<div>
							<h3 class="text-3xl font-bold text-gray-900 flex items-center space-x-2">
								<svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
								</svg>
								<span>Search Results</span>
							</h3>
							<p class="text-gray-600">
								Found <span class="font-bold text-blue-600">{fmt.Sprintf("%d", len(results))}</span> results for 
								<span class="font-bold">"{data["Query"].(string)}"</span>
							</p>
						</div>
						<div>
							<a href="/" class="elegant-btn-outline border-blue-500 text-blue-600 hover:bg-blue-500 hover:text-white">
								<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
								</svg>
								Back to Home
							</a>
						</div>
					</div>
					
					if len(results) > 0 {
						<!-- Results Grid -->
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
							for _, section := range results {
								@TailwindSectionCard(section, getColorForSectionType(section.SectionType))
							}
						</div>
					} else {
						<!-- No Results -->
						<div class="text-center py-16">
							<div class="bg-white rounded-3xl shadow-xl p-12 max-w-md mx-auto">
								<svg class="w-16 h-16 text-gray-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
								</svg>
								<h4 class="text-2xl font-bold text-gray-900 mb-4">No results found</h4>
								<p class="text-gray-600 mb-6">
									We couldn't find any content matching your search. 
									Try adjusting your search terms or explore our main categories.
								</p>
								<a href="/" class="elegant-btn-primary">
									<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
									</svg>
									Browse All Help
								</a>
							</div>
						</div>
					}
				} else {
					<!-- Empty State -->
					<div class="text-center py-16">
						<div class="bg-white rounded-3xl shadow-xl p-12 max-w-lg mx-auto">
							<svg class="w-16 h-16 text-blue-500 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
							</svg>
							<h4 class="text-2xl font-bold text-gray-900 mb-4">Ready to Search?</h4>
							<p class="text-gray-600 mb-6">
								Enter a search term above to find help topics, examples, and tutorials.
							</p>
							<div class="flex flex-wrap justify-center gap-2 mb-6">
								<span class="bg-gray-100 text-gray-700 px-4 py-2 rounded-full text-sm">configuration</span>
								<span class="bg-gray-100 text-gray-700 px-4 py-2 rounded-full text-sm">examples</span>
								<span class="bg-gray-100 text-gray-700 px-4 py-2 rounded-full text-sm">getting started</span>
								<span class="bg-gray-100 text-gray-700 px-4 py-2 rounded-full text-sm">tutorial</span>
								<span class="bg-gray-100 text-gray-700 px-4 py-2 rounded-full text-sm">commands</span>
							</div>
							<small class="text-gray-500">Try searching for one of these popular terms</small>
						</div>
					</div>
				}
			}
		</div>
	</div>
}

// Helper function to get color theme for section type
func getColorForSectionType(sectionType SectionType) string {
	switch sectionType {
	case SectionGeneralTopic:
		return "primary"
	case SectionExample:
		return "success"
	case SectionApplication:
		return "warning"
	case SectionTutorial:
		return "danger"
	default:
		return "secondary"
	}
}

// Helper function to get text color class
func getTextColor(colorTheme string) string {
	switch colorTheme {
	case "primary":
		return "text-blue-600"
	case "success":
		return "text-green-600"
	case "warning":
		return "text-yellow-600"
	case "danger":
		return "text-red-600"
	default:
		return "text-gray-600"
	}
}

// Helper function to get background color class
func getBgColor(colorTheme string) string {
	switch colorTheme {
	case "primary":
		return "bg-blue-500"
	case "success":
		return "bg-green-500"
	case "warning":
		return "bg-yellow-500"
	case "danger":
		return "bg-red-500"
	default:
		return "bg-gray-500"
	}
}

// Helper function to render markdown (simplified)
func renderMarkdown(content string) string {
	// This is a simple markdown renderer - in a real implementation,
	// you might want to use a proper markdown library like blackfriday
	
	// Convert code blocks
	content = strings.ReplaceAll(content, "```", "<pre><code>")
	
	// Convert inline code
	lines := strings.Split(content, "\n")
	for i, line := range lines {
		// Headers
		if strings.HasPrefix(line, "#### ") {
			lines[i] = "<h4>" + strings.TrimPrefix(line, "#### ") + "</h4>"
		} else if strings.HasPrefix(line, "### ") {
			lines[i] = "<h3>" + strings.TrimPrefix(line, "### ") + "</h3>"
		} else if strings.HasPrefix(line, "## ") {
			lines[i] = "<h2>" + strings.TrimPrefix(line, "## ") + "</h2>"
		} else if strings.HasPrefix(line, "# ") {
			lines[i] = "<h1>" + strings.TrimPrefix(line, "# ") + "</h1>"
		}
		
		// Bold
		if strings.Contains(line, "**") {
			parts := strings.Split(line, "**")
			if len(parts) >= 3 {
				for j := 1; j < len(parts); j += 2 {
					parts[j] = "<strong>" + parts[j] + "</strong>"
				}
				lines[i] = strings.Join(parts, "")
			}
		}
		
		// Inline code
		if strings.Contains(line, "`") && !strings.Contains(line, "<code>") {
			parts := strings.Split(line, "`")
			if len(parts) >= 3 {
				for j := 1; j < len(parts); j += 2 {
					parts[j] = "<code>" + parts[j] + "</code>"
				}
				lines[i] = strings.Join(parts, "")
			}
		}
	}
	
	content = strings.Join(lines, "\n")
	
	// Convert newlines to paragraphs (simplified)
	paragraphs := strings.Split(content, "\n\n")
	for i, para := range paragraphs {
		para = strings.TrimSpace(para)
		if para != "" && !strings.HasPrefix(para, "<") {
			paragraphs[i] = "<p>" + strings.ReplaceAll(para, "\n", "<br>") + "</p>"
		}
	}
	
	return strings.Join(paragraphs, "\n")
}
